#!/usr/bin/env bash
#
# Audit #14: block accidental secret commits.
# Install once per clone:  git config core.hooksPath scripts/git-hooks
#
set -euo pipefail

fail() { echo "❌ pre-commit blocked: $1" >&2; exit 1; }

staged=$(git diff --cached --name-only --diff-filter=ACM)

# 1) Never allow a real dotenv file to be committed (.env.example is fine).
while IFS= read -r file; do
    case "$file" in
        .env|.env.*)
            case "$file" in
                .env.example) : ;;                       # template is allowed
                *) fail "attempt to commit dotenv file '$file'. Secrets belong outside git." ;;
            esac
            ;;
    esac
done <<< "$staged"

# 2) Scan added lines for high-signal secret patterns.
#    Only inspect additions in the staged diff to avoid false positives on context.
added=$(git diff --cached --unified=0 | grep -E '^\+' | grep -vE '^\+\+\+' || true)

# Known secret-bearing key names in this project + generic private-key / token shapes.
patterns=(
    'XENDIT_SECRET_KEY[[:space:]]*=[[:space:]]*[^[:space:]]+'
    'GOOGLE_CLIENT_SECRET[[:space:]]*=[[:space:]]*[^[:space:]]+'
    'MOVIDER_API_SECRET[[:space:]]*=[[:space:]]*[^[:space:]]+'
    'AWS_SECRET_ACCESS_KEY[[:space:]]*=[[:space:]]*[^[:space:]]+'
    'TWILIO_AUTH_TOKEN[[:space:]]*=[[:space:]]*[^[:space:]]+'
    '-----BEGIN [A-Z ]*PRIVATE KEY-----'
    'AIza[0-9A-Za-z_\-]{35}'                 # Google API key
    'sk_(live|test)_[0-9A-Za-z]{16,}'        # Stripe-style secret key
)

for p in "${patterns[@]}"; do
    if echo "$added" | grep -Eq "$p"; then
        fail "staged change appears to contain a secret matching /$p/. Move it to an ignored .env and use a placeholder in .env.example."
    fi
done

exit 0
