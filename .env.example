APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# sqlite for local development and tests; use pgsql (Supabase PostgreSQL) for a real environment.
DB_CONNECTION=sqlite
# For pgsql (values come from your own environment — never commit real credentials):
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Audit #2: selects the PaymentGateway implementation (default = Xendit).
PAYMENT_PROVIDER=default

# Xendit (GCash invoices)
XENDIT_SECRET_KEY=
XENDIT_PUBLIC_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=/auth/google/callback

# SMS providers (first configured one wins)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
MOVIDER_API_KEY=
MOVIDER_API_SECRET=
SMS_NOTIFY_NUMBER=

# Google Maps / reCAPTCHA
GOOGLE_MAPS_API_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# RD2-R2: manual owner-verified GCash QR payments. Keep false until the shop owner confirms the receiving
# account is authorised for live use; then set true deliberately in that environment only.
PAYMENTS_GCASH_QR_ENABLED=false

# RD2-R3: customer repair/service appointment requests (Asia/Manila, same-day).
# CONFIRMED schedule (R3 Rev 4): first start 07:30, last start 17:00 inclusive, every 30 min (20 starts).
# PROVISIONAL / unconfirmed with the owner: capacity value (3–5) and unit (per_day | per_slot | simultaneous),
# the operating/closing time (17:00 is the LAST START only), and the approval buffer (ships as 0).
RR_OPEN=07:30
RR_LAST_START=17:00
RR_SLOT_MINUTES=30
RR_CAPACITY=3
RR_CAPACITY_UNIT=simultaneous
RR_WALKIN_MINUTES=60
# Check-in is due 30 minutes before the start; check-in exactly at the deadline is valid.
RR_CHECKIN_MINUTES=30
# Acceptance/requests must be strictly before (check-in deadline − buffer). Buffer ships as 0 (provisional).
RR_APPROVAL_BUFFER_MINUTES=0
# Automatic no-check-in cancellation (accepted, not checked in, stored check-in deadline passed) stays DISABLED until the owner approves go-live.
RR_AUTO_CANCEL_ENABLED=false
# Automatic expiry of unanswered pending requests (stored approval deadline reached) stays DISABLED until the owner approves go-live.
RR_PENDING_EXPIRY_ENABLED=false
